generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------
// User & Auth Domain
// ---------------------------------------------------------
model User {
  id              String    @id @default(uuid())
  username        String    @unique
  email           String    @unique
  passwordHash    String?   // Null if OAuth
  googleId        String?   @unique
  githubId        String?   @unique
  discordId       String?   @unique
  twoFactorEnabled Boolean  @default(false)
  role            Role      @default(USER)

  // Stats & Progression
  eloRating       Int       @default(1200)
  reputation      Int       @default(0)
  xp              Int       @default(0)
  currentStreak   Int       @default(0)
  maxStreak       Int       @default(0)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relationships
  teamId          String?
  team            Team?     @relation(fields: [teamId], references: [id])
  
  submissions     Submission[]
  achievements    UserAchievement[]
  
  matchesAsPlayer1 Match[] @relation("Player1Matches")
  matchesAsPlayer2 Match[] @relation("Player2Matches")
  wonMatches       Match[] @relation("WinnerMatches")
  
  contestRegistrations ContestParticipant[]
  
  recruiterViews  RecruiterView[]
}

enum Role {
  USER
  ADMIN
  RECRUITER
  MODERATOR
}

model Team {
  id          String   @id @default(uuid())
  name        String   @unique
  eloRating   Int      @default(1200)
  members     User[]
  createdAt   DateTime @default(now())
}

model UserAchievement {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  badgeName   String
  description String
  awardedAt   DateTime @default(now())
  
  @@unique([userId, badgeName])
}

// ---------------------------------------------------------
// Problem & Judging Domain
// ---------------------------------------------------------
model Problem {
  id              String       @id @default(uuid())
  title           String
  slug            String       @unique
  description     String
  difficulty      Difficulty   @default(MEDIUM)
  type            ProblemType  @default(DSA) // DSA, SQL, SYSTEM_DESIGN, etc.
  tags            String[]
  
  // Execution constraints
  timeLimitMs     Int          @default(2000)
  memoryLimitMb   Int          @default(256)
  
  isAiGenerated   Boolean      @default(false)
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  testCases       TestCase[]
  submissions     Submission[]
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ProblemType {
  DSA
  SQL
  DEBUGGING
  FRONTEND
  BACKEND
  SYSTEM_DESIGN
  AI_ENGINEERING
}

model TestCase {
  id          String   @id @default(uuid())
  problemId   String
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  
  input       String
  output      String
  isHidden    Boolean  @default(true)
}

model Submission {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  problemId   String
  problem     Problem  @relation(fields: [problemId], references: [id])
  
  matchId     String?
  match       Match?   @relation(fields: [matchId], references: [id])
  
  contestId   String?
  contest     Contest? @relation(fields: [contestId], references: [id])

  code        String
  language    Language
  verdict     Verdict  @default(PENDING)
  
  executionMs Int?
  memoryKb    Int?
  
  // AI Review Scores
  readabilityScore    Int?
  optimizationScore   Int?
  scalabilityScore    Int?
  maintainabilityScore Int?
  
  createdAt   DateTime @default(now())
  
  @@index([userId, problemId])
  @@index([contestId])
}

enum Language {
  PYTHON
  CPP
  JAVA
  GO
  RUST
  JAVASCRIPT
  TYPESCRIPT
}

enum Verdict {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILATION_ERROR
}

// ---------------------------------------------------------
// Arena & Matchmaking Domain
// ---------------------------------------------------------
model Match {
  id          String   @id @default(uuid())
  roomId      String   @unique
  mode        MatchMode
  status      MatchStatus @default(WAITING)
  
  player1Id   String
  player1     User     @relation("Player1Matches", fields: [player1Id], references: [id])
  
  player2Id   String?
  player2     User?    @relation("Player2Matches", fields: [player2Id], references: [id])

  winnerId    String?
  winner      User?    @relation("WinnerMatches", fields: [winnerId], references: [id])
  
  startedAt   DateTime?
  finishedAt  DateTime?
  
  submissions Submission[]
}

enum MatchMode {
  LEETCODE_STYLE
  CODEFORCES_STYLE
  SPEED_CODING
  BUG_FIXING
  DEBUGGING_BATTLES
  SYSTEM_DESIGN
  AI_ASSISTED
}

enum MatchStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ---------------------------------------------------------
// Contest Domain
// ---------------------------------------------------------
model Contest {
  id          String   @id @default(uuid())
  title       String
  type        ContestType
  
  startTime   DateTime
  endTime     DateTime
  
  isAiGenerated Boolean @default(false)
  status      ContestStatus @default(UPCOMING)
  
  createdAt   DateTime @default(now())

  participants ContestParticipant[]
  submissions  Submission[]
}

enum ContestType {
  DAILY_CHALLENGE
  WEEKLY_CONTEST
  KNOCKOUT
  TEAM_CONTEST
}

enum ContestStatus {
  UPCOMING
  ACTIVE
  FINISHED
}

model ContestParticipant {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  contestId   String
  contest     Contest  @relation(fields: [contestId], references: [id])
  
  score       Int      @default(0)
  penalty     Int      @default(0)
  isVirtual   Boolean  @default(false)
  
  @@unique([userId, contestId])
  @@index([contestId, score, penalty]) // Leaderboard index
}

// ---------------------------------------------------------
// Recruiter Domain
// ---------------------------------------------------------
model RecruiterView {
  id          String   @id @default(uuid())
  recruiterId String   // ID of the recruiter (could reference a Recruiter model later)
  candidateId String
  candidate   User     @relation(fields: [candidateId], references: [id])
  viewedAt    DateTime @default(now())
  
  @@index([recruiterId, candidateId])
}

model Campaign {
  id                      String   @id @default(uuid())
  startupId               String
  title                   String
  department              String
  description             String
  requirements            String[]
  techStack               String[]
  compensation            String
  equity                  String
  location                String
  workMode                String
  experienceRequired      String
  fundingStage            String
  startupStage            String
  requiredSkills          String[]
  preferredSkills         String[]
  contestRatingThreshold  Int
  githubActivityThreshold Int
  roleComplexityScore     String
  hiringDifficultyScore   Int
  status                  String   @default("ACTIVE")
  createdAt               DateTime @default(now())

  applications            Application[]
  interviews              Interview[]
}

model Application {
  id                     String   @id @default(uuid())
  campaignId             String
  campaign               Campaign @relation(fields: [campaignId], references: [id])
  candidateId            String
  candidate              User     @relation(fields: [candidateId], references: [id])
  status                 String
  technicalScore         Int?
  skillMatchScore        Int?
  githubScore            Int?
  projectScore           Int?
  cultureFitScore        Int?
  experienceScore        Int?
  hiringProbabilityScore Int?
  overallAiScore         Int?
  appliedAt              DateTime @default(now())
}

model CandidateScore {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id])
  dsaScore               Int
  backendScore           Int
  frontendScore          Int
  aimlScore              Int
  devopsScore            Int
  databaseScore          Int
  systemDesignScore      Int
  securityScore          Int
  githubEngScore         Int
  projectComplexityScore Int
  communicationScore     Int
  overallScore           Int
}

model Interview {
  id                 String   @id @default(uuid())
  campaignId         String
  campaign           Campaign @relation(fields: [campaignId], references: [id])
  candidateId        String
  candidate          User     @relation(fields: [candidateId], references: [id])
  type               String
  scheduledAt        DateTime?
  completedAt        DateTime?
  technicalScore     Int?
  communicationScore Int?
  problemSolvingScore Int?
  ownershipScore     Int?
  transcript         String?
  aiSummary          String?
}
